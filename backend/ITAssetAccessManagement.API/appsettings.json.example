{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=YOUR_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD"
  },

  "Jwt": {
    "Issuer": "ITAssetAccessManagement",
    "Audience": "ITAssetAccessManagementClient",
    "SecretKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}